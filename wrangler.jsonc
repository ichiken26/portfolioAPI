{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "portfolioapi",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-31",
  "routes": [{ "pattern": "api.kokage-studio.com", "custom_domain": true }],
  "d1_databases": [{ "binding": "DB", "database_name": "portfolio", "database_id": "e3eede7c-2d8b-40db-b68b-1d2f81073da1", "migrations_dir": "migrations" }],
  "r2_buckets": [{ "binding": "IMAGES", "bucket_name": "portfolio-images" }],
  "vars": {
    "ALLOWED_ORIGINS": "https://kokage-studio.com",
    "ACCESS_TEAM_DOMAIN": "cold-salad-4ada.cloudflareaccess.com",
    "ACCESS_AUD": "5f705bd65c4d9c20962a4252f4739e10d2123a12294f3531937e208c64d724a1",
    "DEV_AUTH_BYPASS": "false"
  }
}
